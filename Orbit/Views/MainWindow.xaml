<Window x:Class="Orbit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit - Windows Service Manager"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#f8fafc"
        Foreground="#0f172a"
        FontSize="13"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Status Text Color using simple DataTriggers -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#64748b" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#16a34a" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Foreground" Value="#dc2626" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Starting...">
                    <Setter Property="Foreground" Value="#d97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopping...">
                    <Setter Property="Foreground" Value="#d97706" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pin Star Style using DataTrigger -->
        <Style x:Key="PinStarStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#cbd5e1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTracked}" Value="True">
                    <Setter Property="Foreground" Value="#eab308" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Default Button Style -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Default TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header -->
            <RowDefinition Height="*" />    <!-- Content Tabs -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ORBIT" FontSize="18" FontWeight="Bold" Foreground="#2563eb" VerticalAlignment="Center" />
                    <Border Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="12" Foreground="#1d4ed8" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="Đăng xuất" Click="LogoutButton_Click" Background="#fef2f2" Foreground="#dc2626" BorderBrush="#fecaca" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Tab Control -->
        <TabControl Grid.Row="1" Margin="12,8,12,6">

            <!-- TAB 1: TỔNG QUAN & DỊCH VỤ -->
            <TabItem Header="Tổng quan &amp; Dịch vụ">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Stats Cards -->
                        <RowDefinition Height="Auto" /> <!-- Search Bar -->
                        <RowDefinition Height="*" />    <!-- DataGrid & Details -->
                    </Grid.RowDefinitions>

                    <!-- Statistics Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Total -->
                        <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL SERVICES" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding TotalServicesCount}" FontSize="22" FontWeight="Bold" Foreground="#0f172a" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Running -->
                        <Border Grid.Column="1" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding RunningServicesCount}" FontSize="22" FontWeight="Bold" Foreground="#16a34a" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Favorites -->
                        <Border Grid.Column="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="FAVORITES" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding TrackedRunningCount}" FontSize="22" FontWeight="Bold" Foreground="#d97706" />
                                    <TextBlock Text=" / " FontSize="16" Foreground="#94a3b8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TrackedTotalCount}" FontSize="16" FontWeight="SemiBold" Foreground="#64748b" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- CPU -->
                        <Border Grid.Column="3" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding Cpu, StringFormat={}{0:F0}%}" FontSize="22" FontWeight="Bold" Foreground="#2563eb" Margin="0,2,0,0" />
                                <ProgressBar Value="{Binding Cpu}" Maximum="100" Height="3" Foreground="#2563eb" Background="#e2e8f0" BorderThickness="0" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- RAM -->
                        <Border Grid.Column="4" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding Ram, StringFormat={}{0:F0}%}" FontSize="22" FontWeight="Bold" Foreground="#8b5cf6" Margin="0,2,0,0" />
                                <ProgressBar Value="{Binding Ram}" Maximum="100" Height="3" Foreground="#8b5cf6" Background="#e2e8f0" BorderThickness="0" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Search Bar -->
                    <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748b" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="✕ Xóa" Command="{Binding ClearSearchCommand}" Margin="6,0,0,0" Padding="8,4" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hiển thị: " Foreground="#64748b" />
                                <TextBlock Text="{Binding DisplayedCount}" FontWeight="Bold" />
                                <TextBlock Text=" / " Foreground="#64748b" />
                                <TextBlock Text="{Binding TotalServicesCount}" FontWeight="Bold" />
                                <TextBlock Text=" dịch vụ" Foreground="#64748b" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main DataGrid & Detail Panel -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6.5*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="3.5*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid -->
                        <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1">
                            <DataGrid ItemsSource="{Binding DisplayedServices}"
                                      SelectedItem="{Binding SelectedService}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      AlternatingRowBackground="#f8fafc"
                                      RowHeight="32"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <!-- Pin Button -->
                                    <DataGridTemplateColumn Header="Ghim" Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" Padding="4"
                                                        Command="{Binding DataContext.ToggleTrackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="★" Style="{StaticResource PinStarStyle}" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    
                                    <DataGridTemplateColumn Header="Activate" Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" Padding="4"
                                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Toggle"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Status -->
                                    <DataGridTextColumn Header="Trạng thái" Width="100" Binding="{Binding Status}" ElementStyle="{StaticResource StatusTextStyle}" />

                                    <!-- Service Name -->
                                    <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding ServiceName}" Width="160" FontWeight="SemiBold" />

                                    <!-- Display Name -->
                                    <DataGridTextColumn Header="Tên hiển thị" Binding="{Binding DisplayName}" Width="*" />

                                    <!-- Startup Type -->
                                    <DataGridTextColumn Header="Khởi động" Binding="{Binding StartType}" Width="90" Foreground="#64748b" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Right Detail Panel -->
                        <Border Grid.Column="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14">
                            <Grid>
                                <!-- No Selection -->
                                <TextBlock Text="Chọn một dịch vụ để xem chi tiết" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Details View -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="{Binding SelectedService.DisplayName}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedService.ServiceName}" Foreground="#64748b" FontSize="12" Margin="0,2,0,10" />

                                    <!-- Properties -->
                                    <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:" Foreground="#64748b" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedService.Status}" Style="{StaticResource StatusTextStyle}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Có thể dừng:" Foreground="#64748b" Margin="0,6,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedService.CanStop}" FontWeight="SemiBold" Margin="0,6,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Khởi động:" Foreground="#64748b" Margin="0,6,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedService.StartType}" Margin="0,6,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <TextBlock Text="THAO TÁC" FontSize="11" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,6" />
                                    <Button Content="▶ Bắt đầu (Start)" Command="{Binding StartCommand}" Background="#16a34a" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Button Content="■ Dừng (Stop)" Command="{Binding StopCommand}" Background="#dc2626" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Button Content="⟳ Khởi động lại (Restart)" Command="{Binding RestartCommand}" Background="#d97706" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />

                                    <Button Command="{Binding ToggleTrackCommand}" CommandParameter="{Binding SelectedService}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="★ " Style="{StaticResource PinStarStyle}" />
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Thêm vào Yêu thích" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedService.IsTracked}" Value="True">
                                                                <Setter Property="Text" Value="Bỏ khỏi Yêu thích" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: DỊCH VỤ YÊU THÍCH -->
            <TabItem Header="Dịch vụ yêu thích">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Stats -->
                        <RowDefinition Height="Auto" /> <!-- Search Bar -->
                        <RowDefinition Height="*" />    <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- Stats Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="TỔNG YÊU THÍCH" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding TrackedTotalCount}" FontSize="22" FontWeight="Bold" Foreground="#d97706" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="ĐANG CHẠY" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding TrackedRunningCount}" FontSize="22" FontWeight="Bold" Foreground="#16a34a" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="12,8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ĐANG DỪNG" FontSize="10" FontWeight="Bold" Foreground="#64748b" />
                                <TextBlock Text="{Binding TrackedStoppedCount}" FontSize="22" FontWeight="Bold" Foreground="#dc2626" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Search & Auto-Detect -->
                    <Border Grid.Row="1" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748b" />
                            <TextBox Grid.Column="1" Text="{Binding FavoriteSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="✕ Xóa" Command="{Binding ClearFavoriteSearchCommand}" Margin="6,0,0,0" Padding="8,4" />

                            <Button Grid.Column="3" Content="⚡ Tự động thêm dịch vụ Dev" Command="{Binding AutoDetectDevServicesCommand}" Margin="12,0,0,0" />

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hiển thị: " Foreground="#64748b" />
                                <TextBlock Text="{Binding FavoriteDisplayedCount}" FontWeight="Bold" />
                                <TextBlock Text=" / " Foreground="#64748b" />
                                <TextBlock Text="{Binding TrackedTotalCount}" FontWeight="Bold" />
                                <TextBlock Text=" dịch vụ" Foreground="#64748b" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content Area -->
                    <Grid Grid.Row="2">
                        <!-- Empty Message -->
                        <Border Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="24">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFavoriteServices}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Chưa có dịch vụ yêu thích nào" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Nhấn biểu tượng ★ ở tab Tổng quan để ghim dịch vụ," Foreground="#64748b" HorizontalAlignment="Center" />
                                <TextBlock Text="hoặc bấm nút dưới đây để tự động phát hiện các dịch vụ Dev:" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,2,0,12" />
                                <Button Content="⚡ Tự động thêm dịch vụ Dev" Command="{Binding AutoDetectDevServicesCommand}" Background="#2563eb" Foreground="White" FontWeight="SemiBold" Padding="14,8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Favorites Grid & Details -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFavoriteServices}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6.5*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="3.5*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding FavoriteServices}"
                                          SelectedItem="{Binding SelectedService}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          AlternatingRowBackground="#f8fafc"
                                          RowHeight="32"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Ghim" Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Background="Transparent" BorderThickness="0" Padding="4"
                                                            Command="{Binding DataContext.ToggleTrackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="★" Style="{StaticResource PinStarStyle}" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Trạng thái" Width="100" Binding="{Binding Status}" ElementStyle="{StaticResource StatusTextStyle}" />
                                        <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding ServiceName}" Width="160" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Tên hiển thị" Binding="{Binding DisplayName}" Width="*" />
                                        <DataGridTextColumn Header="Khởi động" Binding="{Binding StartType}" Width="90" Foreground="#64748b" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Right Detail Panel -->
                            <Border Grid.Column="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="1" Padding="14">
                                <Grid>
                                    <TextBlock Text="Chọn một dịch vụ để xem chi tiết" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedService}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="{Binding SelectedService.DisplayName}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedService.ServiceName}" Foreground="#64748b" FontSize="12" Margin="0,2,0,10" />

                                        <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trạng thái:" Foreground="#64748b" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedService.Status}" Style="{StaticResource StatusTextStyle}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Có thể dừng:" Foreground="#64748b" Margin="0,6,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedService.CanStop}" FontWeight="SemiBold" Margin="0,6,0,0" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Khởi động:" Foreground="#64748b" Margin="0,6,0,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedService.StartType}" Margin="0,6,0,0" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="THAO TÁC" FontSize="11" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,6" />
                                        <Button Content="▶ Bắt đầu (Start)" Command="{Binding StartCommand}" Background="#16a34a" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Button Content="■ Dừng (Stop)" Command="{Binding StopCommand}" Background="#dc2626" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Button Content="⟳ Khởi động lại (Restart)" Command="{Binding RestartCommand}" Background="#d97706" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />

                                        <Button Command="{Binding ToggleTrackCommand}" CommandParameter="{Binding SelectedService}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="★ " Style="{StaticResource PinStarStyle}" />
                                                <TextBlock Text="Bỏ khỏi Yêu thích" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="#ffffff" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#16a34a" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Fill" Value="#d97706" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#64748b" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
