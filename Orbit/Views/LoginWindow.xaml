<Window x:Class="Orbit.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit - Đăng nhập"
        Height="360" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f8fafc"
        FontSize="13"
        FontFamily="Segoe UI">

    <StackPanel Margin="30,24">
        <!-- Header -->
        <TextBlock Text="ORBIT" FontSize="24" FontWeight="Bold" Foreground="#2563eb" HorizontalAlignment="Center" />
        <TextBlock Text="Windows Service Manager" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,2,0,20" />

        <!-- Form -->
        <TextBlock Text="Tên đăng nhập:" Foreground="#334155" Margin="0,0,0,4" />
        <TextBox x:Name="txtUsername" Padding="8,5" Margin="0,0,0,12" />

        <TextBlock Text="Mật khẩu:" Foreground="#334155" Margin="0,0,0,4" />
        <PasswordBox x:Name="txtPassword" Padding="8,5" Margin="0,0,0,6" />

        <!-- Error -->
        <TextBlock x:Name="txtError" Foreground="#dc2626" FontSize="12" MinHeight="18" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- Buttons -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Đăng nhập" Click="LoginButton_Click" IsDefault="True"
                    Background="#2563eb" Foreground="White" FontWeight="SemiBold" Padding="0,8" Cursor="Hand" />
            <Button Grid.Column="2" Content="Thoát" Click="CancelButton_Click" IsCancel="True"
                    Padding="0,8" Cursor="Hand" />
        </Grid>

        <!-- Hint -->
        <TextBlock Text="Mẫu: admin / admin123  |  camer / 123456" FontSize="11" Foreground="#94a3b8" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
